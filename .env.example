# ---------------------------------------------------------------------------
# PhishGuard environment template.  Copy to ".env" and edit.
#   cp .env.example .env            (Linux / macOS / WSL)
#   copy .env.example .env          (Windows cmd)
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Mandatory in production AND for docker compose. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank for local development: the dev profile falls back to a clearly
# labelled placeholder, and ProductionConfig refuses to start without a real
# value (it also rejects the placeholder itself).
SECRET_KEY=

# --- Docker Compose only -----------------------------------------------------
# docker-compose.yml declares these as REQUIRED with no fallback, so the stack
# will not boot with a hardcoded public password. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=
POSTGRES_DB=phishguard

# development | testing | production
FLASK_CONFIG=development

# SQLite by default; point at PostgreSQL for the Docker profile, e.g.
# DATABASE_URL=postgresql+psycopg2://phishguard:phishguard@db:5432/phishguard
DATABASE_URL=

# --- Session cookies ---------------------------------------------------------
SESSION_COOKIE_SECURE=0           # set to 1 whenever the app is served over HTTPS
SESSION_COOKIE_SAMESITE=Lax
# SameSite guidance - getting this wrong shows up as "CSRF validation failed"
# on every form, because the browser silently stops sending the session cookie:
#   Lax  (default)  correct for http://localhost and normal same-origin use.
#   None            ONLY if the app is embedded in an iframe on another origin.
#                   Browsers require Secure with None, so it needs HTTPS:
#                     SESSION_COOKIE_SAMESITE=None
#                     SESSION_COOKIE_SECURE=1
#                   Setting None without Secure means the cookie is rejected
#                   outright and nothing works.
# The app validates this combination at startup and warns if it is incoherent.
SESSION_LIFETIME_MINUTES=60

# --- Password policy and lockout ---------------------------------------------
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Rate limiting -----------------------------------------------------------
RATELIMIT_ENABLED=1
RATELIMIT_LOGIN=10 per minute;60 per hour
RATELIMIT_ANALYSIS=60 per minute;600 per hour
RATELIMIT_API=120 per minute
# Use redis://redis:6379/0 for a multi-process deployment.
RATELIMIT_STORAGE_URI=memory://

# --- Security headers --------------------------------------------------------
FRAME_ANCESTORS='self'
ENABLE_HSTS=0                     # enable only when TLS is terminated in front
HSTS_MAX_AGE=31536000
CSP_REPORT_ONLY=0

# --- Risk engine -------------------------------------------------------------
HEURISTIC_WEIGHT=0.6
ML_WEIGHT=0.4
ML_ENABLED=1

# --- Behaviour ---------------------------------------------------------------
ALLOW_SELF_REGISTRATION=1
AUDIT_LOG_IP=1
LOG_LEVEL=INFO

# --- Detection tuning -------------------------------------------------------
# Heuristic thresholds. Raise them to reduce false positives, lower them to
# catch more. Every one of these is read at request time from config, so no
# threshold is hardcoded in the analyzers.
URL_ENTROPY_THRESHOLD=4.0
URL_ENTROPY_MIN_HOST_LEN=20
URL_DIGIT_RATIO_THRESHOLD=0.25
URL_LONG_THRESHOLD=75
URL_VERY_LONG_THRESHOLD=120
URL_MANY_SUBDOMAINS=3
URL_HOST_HYPHEN_THRESHOLD=3
URL_DEEP_PATH_THRESHOLD=5
